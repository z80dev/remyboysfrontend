# Copy to .env.local. Leave the new-contract addresses empty until deployed:
# the Legacy Exchange and Remy Vault windows then show a "coming soon" state.
VITE_FREMY=
VITE_NFT_VAULT=
VITE_CONVERTER=
VITE_ROUTER=

# Fork profile: read from a local anvil fork of Base (chainId stays 8453).
# VITE_RPC_URL=http://127.0.0.1:8549
# RPC advertised to wallets when adding the chain; defaults to VITE_RPC_URL.
# VITE_CHAIN_RPC=http://127.0.0.1:8549
