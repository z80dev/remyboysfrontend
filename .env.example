# Copy to .env.local. Empty values use the live Base deployment baked into src/config.ts;
# set them to point the site at a fork deployment instead.
VITE_FREMY=
VITE_NFT_VAULT=
VITE_CONVERTER=
VITE_ROUTER=
VITE_DEPLOYER=

# Fork profile: read from a local anvil fork of Base (chainId stays 8453).
# VITE_RPC_URL=http://127.0.0.1:8549
# RPC advertised to wallets when adding the chain; defaults to VITE_RPC_URL.
# VITE_CHAIN_RPC=http://127.0.0.1:8549

# Public browser Alchemy key (production uses the domain-restricted .env.production key).
# Use a separate development key restricted to your local origin; keep the prod allowlist tight.
VITE_ALCHEMY_API_KEY=
# Shared display data API. Forks need a matching data-service deployment.
# VITE_DATA_API=http://127.0.0.1:8787/api/data
